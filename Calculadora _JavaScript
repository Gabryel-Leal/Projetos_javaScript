# Calculadora Interativa em JavaScript — Operações Aritméticas

# Desenvolvimento de uma calculadora interativa em JavaScript, estruturada para executar operações 
aritméticas básicas: adição, subtração, multiplicação e divisão. O projeto foi desenvolvido com funções 
independentes para cada operação, promovendo a organização do código, a reutilização de funcionalidades 
e a separação de responsabilidades.

# A aplicação utiliza estruturas condicionais ("if/else if/else") para identificar a operação selecionada 
pelo usuário, conversão de valores numéricos com "Number()" e interação por meio dos métodos "prompt()" e 
"alert()". Também implementa uma validação específica para impedir divisões por zero e uma mensagem de 
retorno para operações inválidas.

# Tecnologias e conceitos aplicados: JavaScript, funções, parâmetros e valores de retorno, estruturas 
condicionais, conversão de tipos, entrada e saída de dados e tratamento de condições de erro.

---

function somar(a, b) {
    return a + b;
}

function subtrair(a, b) {
    return a - b;
}

function multiplicar(a, b) {
    return a * b;
}

function dividir(a, b) {
    if (b === 0) {
        return "Erro: não é possível dividir por zero!";
    }

    return a / b;
}

function calculadora() {
    let numero1 = Number(prompt("Digite o primeiro número:"));
    let operador = prompt("Digite a operação (+, -, *, /):");
    let numero2 = Number(prompt("Digite o segundo número:"));

    let resultado;

    if (operador === "+") {
        resultado = somar(numero1, numero2);
    } else if (operador === "-") {
        resultado = subtrair(numero1, numero2);
    } else if (operador === "*") {
        resultado = multiplicar(numero1, numero2);
    } else if (operador === "/") {
        resultado = dividir(numero1, numero2);
    } else {
        resultado = "Operação inválida!";
    }

    alert("Resultado: " + resultado);
}

calculadora();
